# Copy to backend/.env and adjust. Real environment variables take precedence.

# --- Sandbox ---------------------------------------------------------------
# docker (production; build the image first: docker build -t codelens-worker:latest worker)
# subprocess (local development only - NO container isolation)
CODELENS_SANDBOX=docker
# CODELENS_WORKER_IMAGE=codelens-worker:latest
# CODELENS_WORKER_MEMORY=256m
# CODELENS_WORKER_CPUS=0.5
# CODELENS_MAX_CONCURRENT=4

# --- AI provider -------------------------------------------------------------
# auto: Nebius if NEBIUS_API_KEY is set, else Ollama if OLLAMA_MODEL is set, else offline rules
CODELENS_LLM_PROVIDER=auto
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=            # leave empty to auto-pick a Nemotron model from your account's /models list
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# 1 = fail with HTTP 502 instead of silently using offline rules when the provider errors
#     (use for hackathon demos so every answer provably comes from Nebius)
# CODELENS_REQUIRE_PROVIDER=1

# --- REA reverse engineering -------------------------------------------------
# Targets must live under this directory (default: <project>/rea-workspace)
# REA_WORKSPACE_ROOT=
# REA_ALLOW_ANY_PATH=1
# REA_ALLOW_DESTRUCTIVE=1          # debuggers, Frida, write-back tools
# REA_TOOL_TIMEOUT=300
# REA_GHIDRA_STARTUP_TIMEOUT_MS=30000
# REA_HOPPER_STARTUP_TIMEOUT_MS=30000
# GHIDRA_INSTALL_DIR=

# --- MCP over HTTP (Alexa+ / remote agents): python -m app.mcp_server --http ---
# CODELENS_MCP_TOKEN=change-me            # required when --host is not localhost
# CODELENS_MCP_PUBLIC_HOSTS=your-tunnel.example.com

# --- Hosting -----------------------------------------------------------------
# Require this code on every API call (share it with judges/testers); empty = open.
# CODELENS_ACCESS_CODE=
# Delete stored runs older than this many hours (0 = never by age).
# CODELENS_RETENTION_HOURS=72
# Pre-started sandbox containers (faster runs on Docker); 0 disables.
# CODELENS_DOCKER_POOL=2
# Requests per minute per IP on run/AI endpoints.
# CODELENS_RATE_LIMIT_PER_MIN=60

# --- UI ---
# CODELENS_SHOW_REA=1           # show the Reverse Engineering tab (hidden by default)

# --- Web ---------------------------------------------------------------------
# CODELENS_CORS_ORIGINS=http://localhost:5173
